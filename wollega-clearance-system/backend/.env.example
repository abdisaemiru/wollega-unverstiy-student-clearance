# Copy this file to .env and fill in your own values before running the server.

# MongoDB connection string. Examples:
#   Local MongoDB:   mongodb://127.0.0.1:27017/wollega_clearance
#   MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wollega_clearance
MONGODB_URI=mongodb://127.0.0.1:27017/wollega_clearance

# Any long, random string. Used to sign login sessions (JWTs).
JWT_SECRET=change_this_to_a_long_random_string

# Port the API server listens on.
PORT=5000

# Comma-separated list of origins allowed to call this API from a browser.
# If you open the frontend with a local server on port 5500, include it here.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173
